# Segredos do GERID desta máquina. Copie para .env e restrinja: chmod 600 .env
# O .env fica fora do git. Quem tiver este arquivo e o token A3 entra no GERID.

# PIN do token A3 plugado nesta máquina.
GERID_PIN=

# Segredo do autenticador do GERID (a semente do QR, não o código de 6 dígitos):
# Base32 (ex.: JBSWY3DPEHPK3PXP) ou a URI otpauth://totp/...?secret=...
GERID_TOTP_SECRET=

# Opcionais
# GERID_TUNNEL=127.0.0.1:8444        # túnel SSH para a 8443 (login mTLS)
# GERID_TUNNEL_443=127.0.0.1:8445    # túnel SSH para a 443 (mesmo egresso do login)
# INSS_CHROME_PATH=/caminho/do/chrome
